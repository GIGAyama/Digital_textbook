{
  "entryHtml": "index.html",
  "requiredFiles": [
    "index.html",
    "vite.config.js",
    "src/App.jsx",
    "src/main.jsx",
    "src/index.css",
    "LICENSE",
    "README.md",
    "MANUAL.md"
  ],
  "ignoreDirectories": [
    ".git",
    ".github",
    "node_modules",
    "coverage",
    "dist",
    "dev-dist",
    ".assets-original",
    "vendor"
  ],
  "manifest": {
    "forbiddenOauthScopes": [
      "https://www.googleapis.com/auth/drive",
      "https://mail.google.com/"
    ]
  },
  "securityExceptions": {
    "wildcardPostMessage": [],
    "xFrameAllowAll": []
  },
  "maintainability": {
    "warningLineCount": 5000,
    "warningByteCount": 400000,

    "_ignoreLargeFiles": "「1ファイルが大きすぎる」の警告は、人が保守するソースに向けたもの。npm が自動生成するロックファイルは対象外にする。",
    "ignoreLargeFiles": [
      "package-lock.json"
    ]
  },
  "gigaV4": {
    "enabled": true,
    "_basePath": "manifest の id/scope/start_url に期待する値。独自ドメインではアプリは digital-textbook.giga-school.com の直下で配信されるので相対パス \"./\"。vite.config.js の BASE と同じ値にすること。",
  "basePath": "./",

    "_assetLimits": "画像の上限バイト数。アイコンだけで初回転送を占有しないための歯止め。",
    "assetLimits": {
      "default": 153600,
      "favicon.png": 30720,
      "pwa-512x512.png": 61440,
      "pwa-maskable-512x512.png": 61440,
      "pwa-192x192.png": 40960,
      "pwa-maskable-192x192.png": 30720,
      "apple-touch-icon.png": 30720
    },

    "_exceptions": "検査を意図的に見送る項目。ゆるめるのではなく、なぜ見送るかをここに書く。空にしておくのが望ましい。",
    "exceptions": []
  }
}
